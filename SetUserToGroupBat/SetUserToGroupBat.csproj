<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SupportedOSPlatformVersion>6.1</SupportedOSPlatformVersion>
    <SupportedOSPlatform>windows</SupportedOSPlatform>
    <RootNamespace>AtlassianMainteUty</RootNamespace>
    <AssemblyName>SetUserToGroupBat</AssemblyName>
    <StartupObject>AtlassianMainteUty.SetUserToGroupBat</StartupObject>

    <!-- 単一ファイル実行可能ファイルの設定 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>

    <!-- 出力先の設定（ソリューションルートの publish） -->
    <PublishDir>$(MSBuildThisFileDirectory)..\publish</PublishDir>

    <!-- ビルド日時の定義 -->
    <BuildDate>$([System.DateTime]::Now.ToString("yyyy-MM-dd HH:mm"))</BuildDate>

    <!-- アセンブリメタデータの生成を有効化 -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- アセンブリメタデータにビルド日時を埋め込む（exeのプロパティに表示される） -->
  <ItemGroup>
    <AssemblyMetadata Include="BuildDate" Value="$(BuildDate)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Config.json" Link="Config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
